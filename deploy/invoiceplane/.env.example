# Copy to .env on the private Linux host (never commit .env)
# Domain must resolve to the host public IP before Caddy can issue HTTPS.
INVOICE_DOMAIN=invoices.zqremovalsadelaide.com.au

DB_NAME=invoiceplane
DB_USER=invoiceplane
DB_PASSWORD=CHANGE_ME_GENERATE_STRONG_DB_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_GENERATE_STRONG_ROOT_PASSWORD
ENCRYPTION_KEY=CHANGE_ME_GENERATE_STABLE_ENCRYPTION_KEY

# Used only on first database initialisation.
ADMIN_EMAIL=admin@zqremovals.au
ADMIN_PASSWORD=CHANGE_ME_GENERATE_STRONG_ADMIN_PASSWORD
