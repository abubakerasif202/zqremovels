{
  "name": "zq-static-site",
  "private": true,
  "version": "1.0.0",
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead"
  ],
  "description": "Static deployment manifest for Vercel root build.",
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "test": "node scripts/quote-api-smoke.mjs && node scripts/run-node-tests.mjs",
    "test:quote-api": "node scripts/quote-api-smoke.mjs",
    "test:visual-mobile": "playwright test tests/mobile-seo-visual.spec.ts",
    "lhci": "lhci autorun",
    "check:sitemap": "node scripts/seo-validate.mjs",
    "seo:audit": "node scripts/seo-validate.mjs",
    "seo:validate": "node scripts/seo-validate.mjs",
    "gsc:auth": "node scripts/gsc-auth.mjs",
    "gsc:fetch": "node scripts/gsc-fetch.mjs",
    "gsc:opportunities": "node scripts/gsc-analyze-opportunities.mjs",
    "gsc:submit-sitemap": "node scripts/gsc-submit-sitemap.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "browserslist": "^4.28.2",
    "browserslist-to-esbuild": "^2.1.1",
    "esbuild": "^0.28.1",
    "googleapis": "^171.4.0",
    "http-server": "^14.1.1",
    "lightningcss": "^1.32.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.4.6",
    "googleapis": "^171.4.0",
    "hover.css": "^2.3.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "esbuild": "$esbuild",
    "js-yaml": "^4.2.0",
    "tmp": "0.2.7",
    "uuid": "11.1.1",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": "22.x"
  }
}
