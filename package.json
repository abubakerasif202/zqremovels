{
  "name": "zq-static-site",
  "private": true,
  "version": "1.0.0",
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead"
  ],
  "description": "Static deployment manifest for Vercel root build.",
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "test": "node scripts/quote-api-smoke.mjs && node scripts/run-node-tests.mjs",
    "test:quote-api": "node scripts/quote-api-smoke.mjs",
    "test:visual-mobile": "node scripts/run-lhci.mjs",
    "lhci": "lhci autorun",
    "seo:validate": "node scripts/seo-validate.mjs",
    "gsc:auth": "node scripts/gsc-auth.mjs",
    "gsc:fetch": "node scripts/gsc-fetch.mjs",
    "gsc:opportunities": "node scripts/gsc-analyze-opportunities.mjs",
    "gsc:submit-sitemap": "node scripts/gsc-submit-sitemap.mjs"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "browserslist": "^4.28.2",
    "browserslist-to-esbuild": "^2.1.1",
    "esbuild": "^0.28.0",
    "googleapis": "^171.4.0",
    "lightningcss": "^1.32.0"
  },
  "dependencies": {
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^6.4.6",
    "googleapis": "^171.4.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3"
  }
}
