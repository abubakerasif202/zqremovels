---
import '../styles/premium-site.css';

export interface Props {
  title: string;
  description: string;
  canonical: string;
  robots: string;
  themeColor: string;
  ogTitle: string;
  ogDescription: string;
  ogType: string;
  ogUrl: string;
  ogImage: string;
  twitterCard: string;
  twitterTitle: string;
  twitterDescription: string;
  twitterImage: string;
  jsonLd: (string | object)[];
  refresh?: string;
  extraStylesheets?: string[];
  ogImageAlt?: string;
}

const {
  title,
  description,
  canonical,
  robots,
  themeColor,
  ogTitle,
  ogDescription,
  ogType,
  ogUrl,
  ogImage,
  twitterCard,
  twitterTitle,
  twitterDescription,
  twitterImage,
  jsonLd,
  refresh,
  extraStylesheets,
  ogImageAlt,
} = Astro.props;

// Clean URLs to ensure they are on the absolute apex domain https://zqremovals.au
const cleanUrl = (urlStr: string) => {
  if (!urlStr) return '';
  let cleaned = urlStr.replace(/^https?:\/\/(www\.)?zqremovals\.au/i, 'https://zqremovals.au');
  cleaned = cleaned.replace(/^https?:\/\/[a-zA-Z0-9-]+\.vercel\.app/i, 'https://zqremovals.au');
  cleaned = cleaned.replace(/^https?:\/\/localhost:\d+/i, 'https://zqremovals.au');
  if (cleaned.startsWith('/')) {
    cleaned = `https://zqremovals.au${cleaned}`;
  }
  return cleaned;
};

const cleanCanonical = cleanUrl(canonical);
const cleanOgUrl = cleanUrl(ogUrl || canonical);
const cleanOgImage = cleanUrl(ogImage);
const cleanTwitterImage = cleanUrl(twitterImage || ogImage);

const imageAlt = ogImageAlt || ogTitle || title;

// Clean structured data (JSON-LD) URLs
const cleanSchemaStr = (schema: string | object) => {
  let schemaStr = typeof schema === 'string' ? schema : JSON.stringify(schema);
  // Replace all www.zqremovals.au, localhost, and vercel.app URLs to enforce apex domain
  schemaStr = schemaStr.replace(/https?:\/\/(www\.)?zqremovals\.au/g, 'https://zqremovals.au');
  schemaStr = schemaStr.replace(/https?:\/\/localhost:\d+/g, 'https://zqremovals.au');
  schemaStr = schemaStr.replace(/https?:\/\/[a-zA-Z0-9-]+\.vercel\.app/g, 'https://zqremovals.au');
  return schemaStr;
};

const jsonLdBlocks = (jsonLd || []).map(cleanSchemaStr);

// Get tracking IDs from environment variables
const gaId = import.meta.env.VITE_GA_MEASUREMENT_ID || process.env.VITE_GA_MEASUREMENT_ID || import.meta.env.GA_MEASUREMENT_ID || process.env.GA_MEASUREMENT_ID;
const gtmId = import.meta.env.VITE_GTM_ID || process.env.VITE_GTM_ID || import.meta.env.GTM_ID || process.env.GTM_ID;
const googleAdsConversionId = import.meta.env.VITE_GOOGLE_ADS_CONVERSION_ID || process.env.VITE_GOOGLE_ADS_CONVERSION_ID || import.meta.env.GOOGLE_ADS_CONVERSION_ID || process.env.GOOGLE_ADS_CONVERSION_ID;
const googleAdsLeadLabel = import.meta.env.VITE_GOOGLE_ADS_LEAD_LABEL || process.env.VITE_GOOGLE_ADS_LEAD_LABEL || import.meta.env.GOOGLE_ADS_LEAD_LABEL || process.env.GOOGLE_ADS_LEAD_LABEL;
const metaPixelId = import.meta.env.VITE_META_PIXEL_ID || process.env.VITE_META_PIXEL_ID || import.meta.env.META_PIXEL_ID || process.env.META_PIXEL_ID;

const trackingConfig = {
  gaMeasurementId: gaId || null,
  gtmId: gtmId || null,
  googleAdsConversionId: googleAdsConversionId || null,
  googleAdsLeadLabel: googleAdsLeadLabel || null,
  metaPixelId: metaPixelId || null,
};

const trackingConfigStr = JSON.stringify(trackingConfig);
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={cleanCanonical} />
    <meta name="theme-color" content={themeColor || '#0A192F'} />
    <meta name="robots" content={robots || 'index,follow,max-image-preview:large'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="geo.region" content="AU-SA" />
    <meta name="geo.placename" content="Adelaide, South Australia" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType || 'website'} />
    <meta property="og:site_name" content="ZQ Removals" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:url" content={cleanOgUrl} />
    <meta property="og:title" content={ogTitle || title} />
    <meta property="og:description" content={ogDescription || description} />
    <meta property="og:image" content={cleanOgImage} />
    <meta property="og:image:alt" content={imageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content={twitterCard || 'summary_large_image'} />
    <meta name="twitter:title" content={twitterTitle || ogTitle || title} />
    <meta name="twitter:description" content={twitterDescription || ogDescription || description} />
    <meta name="twitter:image" content={cleanTwitterImage || cleanOgImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {refresh && <meta http-equiv="refresh" content={refresh} />}

    <!-- Alternate Text Links -->
    <link rel="alternate" type="text/markdown" href="/llms.txt" />
    <link rel="alternate" type="text/markdown" href="/llms-full.txt" />

    {extraStylesheets && extraStylesheets.map((stylesheet) => (
      <link rel="stylesheet" href={stylesheet} />
    ))}

    <!-- Tracking Head Scripts -->
    <script is:inline set:html={`window.__analyticsConfig = ${trackingConfigStr};`} />

    {gaId && (
      <script is:inline set:html={`
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = gtag;
        window.__loadGtag = function(){
          if (window.__gtagLoaded) return;
          window.__gtagLoaded = true;
          var script = document.createElement('script');
          script.async = true;
          script.src = 'https://www.googletagmanager.com/gtag/js?id=${gaId}';
          document.head.appendChild(script);
          gtag('js', new Date());
          gtag('config', '${gaId}');
        };
        if ('requestIdleCallback' in window) {
          requestIdleCallback(window.__loadGtag, { timeout: 3500 });
        } else {
          window.addEventListener('load', function(){ setTimeout(window.__loadGtag, 1200); }, { once: true });
        }
      `} />
    )}

    {gtmId && (
      <>
        <script is:inline set:html={`
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        `} />
        <script is:inline async src={`https://www.googletagmanager.com/gtm.js?id=${gtmId}`} />
      </>
    )}

    {metaPixelId && (
      <script is:inline set:html={`
        !function(f,b,e,v,n,t,s){
        if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)
        }(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init','${metaPixelId}');
        fbq('track','PageView');
      `} />
    )}

    <!-- JSON-LD Structured Data -->
    {jsonLdBlocks.map((schemaStr) => (
      <script is:inline type="application/ld+json" set:html={schemaStr} />
    ))}
  </head>
  <body class="bg-navy text-slate-100">
    {gtmId && (
      <noscript>
        <iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`} height="0" width="0" style="display:none;visibility:hidden" />
      </noscript>
    )}
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>
