---
import 'animate.css/animate.min.css';
export interface Props {
  headHtml: string;
  bodyTopHtml?: string;
  layout: string;
  bodyClasses?: string[];
}

const { headHtml, bodyTopHtml, layout, bodyClasses = [] } = Astro.props;
const pageBodyClasses = ['bg-navy', 'text-slate-100', ...bodyClasses];

// Get tracking IDs from environment variables
const gaId =
  import.meta.env.VITE_GA_MEASUREMENT_ID ||
  process.env.VITE_GA_MEASUREMENT_ID ||
  import.meta.env.GA_MEASUREMENT_ID ||
  process.env.GA_MEASUREMENT_ID;

const gtmId = 'GTM-WJGKPXFL';

const metaPixelId =
  import.meta.env.VITE_META_PIXEL_ID ||
  process.env.VITE_META_PIXEL_ID ||
  import.meta.env.META_PIXEL_ID ||
  process.env.META_PIXEL_ID;

const trackingConfig = {
  gaMeasurementId: gaId || null,
  gtmId: gtmId || null,
  metaPixelId: metaPixelId || null,
};

const trackingConfigStr = JSON.stringify(
  Object.fromEntries(
    Object.entries(trackingConfig).filter(([, value]) => Boolean(value)),
  ),
);
---
<!doctype html>
<html lang="en-AU" data-theme="zqtheme">
  <head>
    <!-- Fail closed until an existing CMP supplies a consent update. Never replace queued decisions. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      if (!window.dataLayer.some(function(entry) { return entry && entry[0] === 'consent'; })) {
        window.dataLayer.push((function() { return arguments; })('consent', 'default', {
          ad_storage: 'denied', analytics_storage: 'denied',
          ad_user_data: 'denied', ad_personalization: 'denied'
        }));
      }
    </script>
    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){if(w.__zqGtmLoaded)return;w.__zqGtmLoaded=true;w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-WJGKPXFL');
    </script>
    <!-- End Google Tag Manager -->

    {layout === 'bare' && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
          href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700&family=Source+Sans+3:wght@300;400;500;600;700&display=swap"
          rel="stylesheet"
        />
      </>
    )}

    <!-- Inject SEO/JSON-LD/OG tags from legacy generator -->
    <Fragment set:html={headHtml} />

    <!-- Tracking Head Scripts -->
    <script is:inline set:html={`window.__analyticsConfig = ${trackingConfigStr};`} />

    {gaId && (
      <script is:inline set:html={`
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', '${gaId}');
        window.__loadGtag = function(){
          if (window.__gtagLoaded) return;
          var existing = Array.from(document.scripts).some(function(script) {
            try {
              var url = new URL(script.src, location.href);
              return url.hostname === 'www.googletagmanager.com' &&
                url.pathname === '/gtag/js' && url.searchParams.get('id') === '${gaId}';
            } catch (_) { return false; }
          });
          window.__gtagLoaded = true;
          if (existing) return;
          var script = document.createElement('script');
          script.async = true;
          script.src = 'https://www.googletagmanager.com/gtag/js?id=${gaId}';
          document.head.appendChild(script);
        };
        // GTM processes the queued config and loads its destination. Keep a fallback
        // for blocked or unavailable containers without injecting a second GA loader.
        if (${Boolean(gtmId)}) {
          setTimeout(window.__loadGtag, 3500);
        } else {
          window.__loadGtag();
        }
      `} />
    )}

    {metaPixelId && (
      <script is:inline set:html={`
        !function(f,b,e,v,n,t,s){
        if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)
        }(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init','${metaPixelId}');
        fbq('track','PageView');
      `} />
    )}
  </head>

  <body class:list={pageBodyClasses}>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe
      src="https://www.googletagmanager.com/ns.html?id=GTM-WJGKPXFL"
      height="0"
      width="0"
      style="display:none;visibility:hidden"
    /></noscript>
    <!-- End Google Tag Manager (noscript) -->

    {bodyTopHtml && <Fragment set:html={bodyTopHtml} />}

    {layout === 'standard' && (
      <a class="skip-link" href="#main-content">Skip to content</a>
    )}

    <slot />

    {layout === 'standard' && (
      <div class="sticky-mobile-cta" id="sticky-cta" role="region" aria-label="Quick contact actions">
        <a class="btn btn-outline btn-sm button button-secondary hvr-pulse" href="tel:+61433819989">
          Call 0433 819 989
        </a>
        <a class="btn btn-primary btn-sm button button-primary hvr-grow" href="/contact-us/#quote-form">
          Get a Free Quote
        </a>
      </div>
    )}

    {(layout === 'standard' || layout === 'bare') && (
      <script type="module" src="/site.js"></script>
      <script type="module" src="/chat-widget.mjs"></script>
    )}
  </body>
</html>
