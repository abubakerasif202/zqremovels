---
import 'animate.css/animate.min.css';
export interface Props {
  headHtml: string;
  bodyTopHtml?: string;
  layout: string;
  bodyClasses?: string[];
}

const { headHtml, bodyTopHtml, layout, bodyClasses = [] } = Astro.props;
const pageBodyClasses = ['bg-navy', 'text-slate-100', ...bodyClasses];

// Get tracking IDs from environment variables
const gaId =
  import.meta.env.VITE_GA_MEASUREMENT_ID ||
  process.env.VITE_GA_MEASUREMENT_ID ||
  import.meta.env.GA_MEASUREMENT_ID ||
  process.env.GA_MEASUREMENT_ID;

const gtmId = 'GTM-WJGKPXFL';

const metaPixelId =
  import.meta.env.VITE_META_PIXEL_ID ||
  process.env.VITE_META_PIXEL_ID ||
  import.meta.env.META_PIXEL_ID ||
  process.env.META_PIXEL_ID;

const trackingConfig = {
  gaMeasurementId: gaId || null,
  gtmId: gtmId || null,
  metaPixelId: metaPixelId || null,
};

const trackingConfigStr = JSON.stringify(
  Object.fromEntries(
    Object.entries(trackingConfig).filter(([, value]) => Boolean(value)),
  ),
);
---
<!doctype html>
<html lang="en-AU" data-theme="zqtheme">
  <head>
    <!-- Consent defaults are established before any optional tracking code. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      var saved;
      try {
        var match = document.cookie.match(/(?:^|; )zq_consent_v1=([^;]+)/);
        if (match) {
          var value = JSON.parse(decodeURIComponent(match[1]));
          if (value && value.version === 1 && Number.isFinite(value.updatedAt) &&
              Date.now() - value.updatedAt >= 0 && Date.now() - value.updatedAt < 15552000000 &&
              typeof value.analytics === 'boolean' && typeof value.advertising === 'boolean') saved = value;
        }
      } catch (_) {}
      window.__zqConsentChoice = saved;
      window.dataLayer.push((function() { return arguments; })('consent', 'default', {
        ad_storage: saved && saved.advertising ? 'granted' : 'denied',
        analytics_storage: saved && saved.analytics ? 'granted' : 'denied',
        ad_user_data: saved && saved.advertising ? 'granted' : 'denied',
        ad_personalization: saved && saved.advertising ? 'granted' : 'denied'
      }));
    </script>

    {layout === 'bare' && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
          href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700&family=Source+Sans+3:wght@300;400;500;600;700&display=swap"
          rel="stylesheet"
        />
      </>
    )}

    <!-- Inject SEO/JSON-LD/OG tags from legacy generator -->
    <Fragment set:html={headHtml} />

    <!-- Tracking Head Scripts -->
    <script is:inline set:html={`window.__analyticsConfig = ${trackingConfigStr};`} />

    {gaId && (
      <script is:inline set:html={`
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = gtag;
        window.__loadGtag = function(){
          if (window.__gtagLoaded) return;
          var existing = Array.from(document.scripts).some(function(script) {
            try {
              var url = new URL(script.src, location.href);
              return url.hostname === 'www.googletagmanager.com' &&
                url.pathname === '/gtag/js' && url.searchParams.get('id') === '${gaId}';
            } catch (_) { return false; }
          });
          window.__gtagLoaded = true;
          if (existing) return;
          var script = document.createElement('script');
          script.async = true;
          script.src = 'https://www.googletagmanager.com/gtag/js?id=${gaId}';
          document.head.appendChild(script);
          gtag('js', new Date());
          gtag('config', '${gaId}');
        };
      `} />
    )}

  </head>

  <body class:list={pageBodyClasses}>
    {bodyTopHtml && <Fragment set:html={bodyTopHtml} />}

    {layout === 'standard' && (
      <a class="skip-link" href="#main-content">Skip to content</a>
    )}

    <slot />

    <section class="zq-consent" data-consent-banner aria-label="Privacy preferences" hidden>
      <div class="zq-consent__content">
        <h2>Privacy preferences</h2>
        <p>We use optional analytics and advertising storage only with your permission. You can change your choice at any time. <a href="/privacy/">Read our privacy policy.</a></p>
        <div class="zq-consent__preferences" data-consent-preferences hidden>
          <label><input type="checkbox" data-consent-analytics /> Analytics</label>
          <label><input type="checkbox" data-consent-advertising /> Advertising</label>
        </div>
        <div class="zq-consent__actions">
          <button type="button" data-consent-accept>Accept all</button>
          <button type="button" data-consent-reject>Reject optional</button>
          <button type="button" data-consent-customize aria-expanded="false">Set preferences</button>
          <button type="button" data-consent-save hidden>Save preferences</button>
        </div>
      </div>
    </section>
    <button class="zq-consent-manage" type="button" data-consent-manage hidden>Privacy choices</button>

    {layout === 'standard' && (
      <div class="sticky-mobile-cta" id="sticky-cta" role="region" aria-label="Quick contact actions">
        <a class="btn btn-outline btn-sm button button-secondary hvr-pulse" href="tel:+61433819989">
          Call 0433 819 989
        </a>
        <a class="btn btn-primary btn-sm button button-primary hvr-grow" href="/contact-us/#quote-form">
          Get a Free Quote
        </a>
      </div>
    )}

    {(layout === 'standard' || layout === 'bare') && (
      <script type="module" src="/consent-manager.mjs"></script>
      <script type="module" src="/site.js"></script>
      <script type="module" src="/chat-widget.mjs"></script>
    )}
  </body>
</html>
