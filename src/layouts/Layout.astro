---
import '../styles/premium-site.css';

export interface Props {
  headHtml: string;
  bodyTopHtml?: string;
  layout: string;
}

const { headHtml, bodyTopHtml, layout } = Astro.props;

// Get tracking IDs from environment variables
const gaId = import.meta.env.VITE_GA_MEASUREMENT_ID || process.env.VITE_GA_MEASUREMENT_ID || import.meta.env.GA_MEASUREMENT_ID || process.env.GA_MEASUREMENT_ID;
const gtmId = import.meta.env.VITE_GTM_ID || process.env.VITE_GTM_ID || import.meta.env.GTM_ID || process.env.GTM_ID;
const googleAdsConversionId = import.meta.env.VITE_GOOGLE_ADS_CONVERSION_ID || process.env.VITE_GOOGLE_ADS_CONVERSION_ID || import.meta.env.GOOGLE_ADS_CONVERSION_ID || process.env.GOOGLE_ADS_CONVERSION_ID;
const googleAdsLeadLabel = import.meta.env.VITE_GOOGLE_ADS_LEAD_LABEL || process.env.VITE_GOOGLE_ADS_LEAD_LABEL || import.meta.env.GOOGLE_ADS_LEAD_LABEL || process.env.GOOGLE_ADS_LEAD_LABEL;
const metaPixelId = import.meta.env.VITE_META_PIXEL_ID || process.env.VITE_META_PIXEL_ID || import.meta.env.META_PIXEL_ID || process.env.META_PIXEL_ID;

const trackingConfig = {
  gaMeasurementId: gaId || null,
  gtmId: gtmId || null,
  googleAdsConversionId: googleAdsConversionId || null,
  googleAdsLeadLabel: googleAdsLeadLabel || null,
  metaPixelId: metaPixelId || null,
};

const trackingConfigStr = JSON.stringify(trackingConfig);
---
<!doctype html>
<html lang="en-AU">
  <head>
    {layout === 'bare' && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700&family=Source+Sans+3:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
      </>
    )}
    <!-- Inject SEO/JSON-LD/OG tags from legacy generator -->
    <Fragment set:html={headHtml} />

    <!-- Tracking Head Scripts -->
    <script is:inline set:html={`window.__analyticsConfig = ${trackingConfigStr};`} />

    {gaId && (
      <script is:inline set:html={`
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = gtag;
        window.__loadGtag = function(){
          if (window.__gtagLoaded) return;
          window.__gtagLoaded = true;
          var script = document.createElement('script');
          script.async = true;
          script.src = 'https://www.googletagmanager.com/gtag/js?id=${gaId}';
          document.head.appendChild(script);
          gtag('js', new Date());
          gtag('config', '${gaId}');
        };
        if ('requestIdleCallback' in window) {
          requestIdleCallback(window.__loadGtag, { timeout: 3500 });
        } else {
          window.addEventListener('load', function(){ setTimeout(window.__loadGtag, 1200); }, { once: true });
        }
      `} />
    )}

    {gtmId && (
      <>
        <script is:inline set:html={`
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        `} />
        <script is:inline async src={`https://www.googletagmanager.com/gtm.js?id=${gtmId}`} />
      </>
    )}

    {metaPixelId && (
      <script is:inline set:html={`
        !function(f,b,e,v,n,t,s){
        if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)
        }(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init','${metaPixelId}');
        fbq('track','PageView');
      `} />
    )}
  </head>
  <body class="bg-navy text-slate-100">
    {gtmId && (
      <noscript>
        <iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`} height="0" width="0" style="display:none;visibility:hidden" />
      </noscript>
    )}
    {bodyTopHtml && <Fragment set:html={bodyTopHtml} />}
    {layout === 'standard' && (
      <a class="skip-link" href="#main-content">Skip to content</a>
    )}
    
    <slot />

    {layout === 'standard' && (
      <div class="sticky-mobile-cta" id="sticky-cta">
        <a class="button button-secondary" href="tel:+61433819989">Call 0433 819 989</a>
        <a class="button button-primary" href="/contact-us/#quote-form">Get Fixed-Price Quote</a>
      </div>
    )}

    {(layout === 'standard' || layout === 'bare') && (
      <script type="module" src="/site.js"></script>
    )}
  </body>
</html>
