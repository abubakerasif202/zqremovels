---
import { businessIdentity } from '../../site-src/data/business.mjs';

const currentYear = new Date().getFullYear();
---
<footer class="footer-shell">
  <div class="container footer-grid">
    <div class="footer-panel footer-brand-panel">
      <span class="eyebrow">Established Excellence</span>
      <h2 class="footer-brand-title">Adelaide removals built around clear quotes and careful handling.</h2>
      <p>
        ZQ Removals helps Adelaide households and businesses plan local and interstate moves with careful furniture handling, packing support, and clear quote requests.
      </p>
      
      <address class="nap" itemscope itemtype="https://schema.org/MovingCompany">
        <strong itemprop="name">{businessIdentity.name}</strong>
        <span itemprop="address" itemscope itemtype="https://schema.org/PostalAddress">
          <span itemprop="addressLocality">{businessIdentity.address.locality}</span> <span itemprop="addressRegion">{businessIdentity.address.region}</span> <span itemprop="postalCode">{businessIdentity.address.postalCode}</span>
        </span>
        <span>ABN {businessIdentity.abn.formatted}</span>
        <a href={`tel:${businessIdentity.phone.tel}`} itemprop="telephone">{businessIdentity.phone.display}</a>
        <a href={`mailto:${businessIdentity.email}`} itemprop="email">{businessIdentity.email}</a>
      </address>
      <p class="field-note">Business details available on request. Ask about cover, building requirements, and move protection before booking.</p>

      <div class="mt-4 flex gap-2 flex-wrap">
        <a href="/contact-us/#quote-form" class="btn btn-primary btn-sm" aria-label="Get free quote on the contact form">Get Free Quote</a>
        <a href={`tel:${businessIdentity.phone.tel}`} class="btn btn-outline btn-sm">{businessIdentity.phone.display}</a>
      </div>
    </div>

    <div class="footer-link-groups">
      <div class="footer-panel">
        <h2 class="footer-title footer-title-styled">Services</h2>
        <ul class="footer-link-list">
          <li><a href="/house-removals-adelaide/">Home move services</a></li>
          <li><a href="/furniture-removalists-adelaide/">Furniture handling support</a></li>
          <li><a href="/office-removals-adelaide/">Office relocation planning</a></li>
          <li><a href="/apartment-removalists-adelaide/">Apartment access planning</a></li>
          <li><a href="/fixed-price-removalists-adelaide/">Compare fixed-price options</a></li>
          <li><a href="/same-day-removalists-adelaide/">Urgent move planning</a></li>
          <li><a href="/packing-services-adelaide/">Packing and preparation</a></li>
          <li><a href="/interstate-removals-adelaide/">Interstate route planning</a></li>
        </ul>
      </div>

      <div class="footer-panel">
        <h2 class="footer-title footer-title-styled">Areas</h2>
        <ul class="footer-link-list">
          <li><a href="/about/">About ZQ Removals</a></li>
          <li><a href="/removalists-adelaide/">Adelaide moving coverage</a></li>
          <li><a href="/removalists-northern-adelaide/">Northern Adelaide routes</a></li>
          <li><a href="/removalists-southern-adelaide/">Southern Adelaide routes</a></li>
          <li><a href="/removalists-adelaide-cbd/">Adelaide CBD access planning</a></li>
          <li><a href="/removalists-marion/">Marion and southern suburbs coverage</a></li>
          <li><a href="/removalists-glenelg/">Glenelg and coastal moving access</a></li>
          <li><a href="/removalists-salisbury/">Salisbury and northern suburbs moves</a></li>
          <li><a href="/removalists-norwood/">Norwood and eastern suburbs moves</a></li>
          <li><a href="/removalists-mawson-lakes/">Mawson Lakes</a></li>
        </ul>
      </div>

      <div class="footer-panel">
        <h2 class="footer-title footer-title-styled">Planning</h2>
        <ul class="footer-link-list">
          <li><a href="/adelaide-moving-guides/">Adelaide Moving Guides</a></li>
          <li><a href="/adelaide-moving-guides/how-much-do-removalists-cost-adelaide/">How Much Do Removalists Cost?</a></li>
          <li><a href="/adelaide-moving-guides/moving-house-adelaide-checklist/">Moving House Adelaide Checklist</a></li>
          <li><a href="/adelaide-moving-guides/best-time-to-book-removalists-adelaide/">Best Time to Book Removalists</a></li>
          <li><a href="/adelaide-moving-guides/how-to-prepare-furniture-for-moving/">How to Prepare Furniture</a></li>
          <li><a href="/adelaide-moving-guides/apartment-moving-tips-adelaide/">Apartment Moving Tips</a></li>
          <li><a href="/adelaide-moving-guides/removalists-cost-adelaide/">Understand pricing factors</a></li>
          <li><a href="/cheap-removalists-adelaide/">Compare lower-cost moves</a></li>
          <li><a href="/affordable-removalists-adelaide/">Affordable move options</a></li>
          <li><a href="/budget-removalists-adelaide/">Budget-aware move planning</a></li>
          <li><a href="/removalist-cost-adelaide/">Removalist cost guide</a></li>
          <li><a href="/adelaide-moving-guides/moving-house-checklist-adelaide/">Moving house checklist</a></li>
          <li><a href="/moving-checklist-adelaide/">Adelaide Moving Checklist</a></li>
          <li><a href="/adelaide-moving-guides/how-to-choose-removalists-adelaide/">Choosing removalists</a></li>
          <li><a href="/adelaide-moving-guides/apartment-lift-bookings-adelaide/">Apartment access guide</a></li>
          <li><a href="/adelaide-moving-guides/coastal-moving-access-adelaide/">Coastal access guide</a></li>
          <li><a href="/adelaide-to-sydney-removalists/">Adelaide to Sydney route</a></li>
          <li><a href="/adelaide-to-melbourne-removalists/">Adelaide to Melbourne route</a></li>
          <li><a href="/adelaide-to-brisbane-removals/">Adelaide to Brisbane route</a></li>
          <li><a href="/adelaide-to-canberra-removals/">Adelaide to Canberra route</a></li>
          <li><a href="/adelaide-to-perth-removals/">Adelaide to Perth route</a></li>
          <li><a href="/adelaide-to-queensland-removals/">Adelaide to Queensland route</a></li>
          <li><a href="/moving-quotes-adelaide/">Compare Adelaide quote options</a></li>
          <li><a href="/removalists-adelaide-quote/">Start a quote brief</a></li>
          <li><a href="https://facebook.com/zqremovals" rel="noopener noreferrer" target="_blank">Facebook</a></li>
          <li><a href="/contact-us/#quote-form">Start Move Brief</a></li>
        </ul>
      </div>

      <div class="footer-panel" data-social-section hidden>
        <h2 class="footer-title footer-title-styled">Social</h2>
        <ul class="footer-link-list" data-social-links></ul>
      </div>
    </div>
  </div>

  <div class="container footer-bottom">
    <span>&copy; <span data-year>{currentYear}</span> {businessIdentity.name} &middot; Adelaide Relocation &amp; Logistics.</span>
    <div class="footer-bottom-links">
      <a href="/privacy-policy/">Privacy</a>
      <a href="/terms-and-conditions/">Terms</a>
      <a href="/sitemap.xml">Sitemap</a>
    </div>
  </div>
</footer>
